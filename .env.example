# Browser demo is explicit. Use supabase for email/password and LMS sign-in.
VITE_DATA_BACKEND=local
VITE_TRACKER_SUPABASE_URL=
VITE_TRACKER_SUPABASE_PUBLISHABLE_KEY=
# Optional LMS launch/login URL; configure LMS to hand off to /auth/callback.
VITE_LMS_APP_URL=
# No LMS browser Auth client is needed: the exchange is server-to-server.
# Never put service-role, signing keys or LMS exchange secrets in VITE_ variables.
